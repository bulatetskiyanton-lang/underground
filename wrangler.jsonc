{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "underground",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "vars": {
    // номер голоса лича в ElevenLabs — не секрет, без ключа он бесполезен
    "ELEVENLABS_VOICE_ID": "KYdoRakolKZAEj8oZgAm"
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
